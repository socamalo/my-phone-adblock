#!name = 我的手机去广告 v1.0.4
#!desc = [v1.0.4] 根据本机 Shadowrocket 请求日志找出的广告域名。纯广告域按域名层 REJECT；第一方 App 上的开屏广告按路径 rewrite 拦截（仅高德 / 阿里弹层，需 MITM）。 / Ad domains found in this phone's own request log. Pure ad domains blocked at the domain layer; splash ads on first-party apps blocked by path rewrite (AMap / Alibaba pop-layer only, requires MITM).
#!author = socamalo
#!homepage = https://github.com/socamalo/my-phone-adblock
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Reject.png
#!url = https://raw.githubusercontent.com/socamalo/my-phone-adblock/main/my-phone-adblock.sgmodule
#!raw-url = https://raw.githubusercontent.com/socamalo/my-phone-adblock/main/my-phone-adblock.sgmodule
#!category = 去广告
#!date = 2026-10-17
#!version = 1.0.4

# ==========================================================================
# 我的手机去广告 v1.0.4  ·  构建日期 2026-10-17
# ==========================================================================
# 层一 域名级（无需 HTTPS 解密） : 42 条生效 + 8 条可选（注释掉）
# 层二 路径级（需要 HTTPS 解密） : 2 条生效（高德开屏、阿里弹层）+ 2 条可选（淘宝开屏）
# 数据源                        : Shadowrocket 日志 2026-10-15~17，57,814 条记录 / 794 个域名 / 43.6 小时
#
# 调试提示：版本号同时写在 #!name 和这里。在 Shadowrocket 的模块列表里看到的
# 名字就带版本；日志里命中的规则文本则是 DOMAIN-SUFFIX / 正则原文。
# 改了 src/rules.js 一定要重新跑 `node tools/build.mjs`，否则手机上跑的还是上一版。

# 本模块怎么来的 / How this module was made
# ---------------------------------------------------------------------------
# 数据源：Shadowrocket 日志 2026-10-15/16，13,921 条记录 / 794 个域名 / 14.0 小时。没有整段照搬任何社区规则库——社区库是给所有人用的，
# 因而也一定会拦住你手机上某个正在用的功能。这里只保留「抓包里真实出现过，且供应商身份明确是广告」的域名。
#
# 社区库只用作第二意见：ad-tier 的每个域名都同时满足「本机抓包见过」和「至少一家权威广告库收录」。
#
# 关于 never 档：日志里有 31 个域名同样被权威广告库收录，但拦了会坏手机——HTTPDNS、推送长连接、App 自研的 RPC 框架、滑块/人机验证、崩溃上报。
# 它们故意不在这个模块里，列在源码的 never 档并由测试守死。
#
# 本模块的域名级规则只含第三方广告厂商域名。日志里的第一方埋点域名（各家 App 自己的 stat/log 域）刻意不收录：那些域名本身就等于一份"装了哪些 App"的清单，而这个仓库是公开的。
#
# v1.0.4 起新增层二（路径级 rewrite）。原因：网易云、高德这类 App 的开屏广告挂在第一方域名下，
# 域名级规则天然看不见。层二只对下面 4 个已确认的域做 MITM，不做全域解密；每条的抓包次数与来源都写在规则上方。
# 仍未覆盖的：京东开屏（社区做法是用 http-response 脚本剥离响应体，不是域名/路径能解决的）、淘宝开屏（见层二里的可选规则）。

[Rule]

# ==========================================================================
# A 档 · 纯广告网络 / 广告 SDK —— 默认生效
# ==========================================================================
# 第三方广告公司。这些公司的全部业务就是投放广告，所以 App 里不可能有别的功能依赖它们。

# 字节跳动 穿山甲 (Pangle)
# 本机 App 类别：某内容社区 App | 抓包命中 34 次 | 权威广告库：anti-AD
# 穿山甲 SDK 主接口。抓包里 34 次，域名带 pangolin-sdk-toutiao 特征，不可能有别的用途。
DOMAIN-SUFFIX, pangolin-sdk-toutiao.com, REJECT

# 字节跳动 穿山甲 (Pangle)
# 本机 App 类别：某内容社区 App | 抓包命中 24 次 | 权威广告库：anti-AD
# 穿山甲备用域名（后缀多一个 1）。不单独列就会被主域名的后缀规则漏掉。
DOMAIN-SUFFIX, pangolin-sdk-toutiao1.com, REJECT

# 字节跳动 GroMore (聚合)
# 抓包命中 8 次 | 权威广告库：anti-AD
# 穿山甲的聚合变现平台，本身不产内容，只产广告。
DOMAIN-SUFFIX, gromore.pangolin-sdk-toutiao.com, REJECT

# 字节跳动 穿山甲静态资源
# 抓包命中 3 次 | 权威广告库：anti-AD
# pglstatp = Pangle static。纯广告素材 CDN，和音乐类 App 那种 iad* 素材域一个道理。
DOMAIN-SUFFIX, pglstatp-toutiao.com, REJECT

# 腾讯广点通 (GDT)
# 本机 App 类别：某智能门锁 App | 抓包命中 6 次 | 权威广告库：anti-AD / StevenBlack
# 广点通投放主域（c3/v3/mi 三个子域都有）。腾讯广告的核心投放接口。
DOMAIN-SUFFIX, gdt.qq.com, REJECT

# 腾讯广点通素材 CDN
# 抓包命中 2 次 | 权威广告库：anti-AD / AdGuard-CN
# qzs.gdtimg.com 是广点通图片素材域，只服务广告。
DOMAIN-SUFFIX, gdtimg.com, REJECT

# 腾讯广告 SDK 上报
# 抓包命中 3 次 | 权威广告库：anti-AD / StevenBlack
# e.qq.com 是腾讯广告的短域。只拦 sdk.e.qq.com 这个具体子域而不是整个 e.qq.com —— 后者太宽，可能扫到别的东西。
DOMAIN-SUFFIX, sdk.e.qq.com, REJECT

# 腾讯广告 SDK 上报 (QUIC)
# 抓包命中 2 次 | 权威广告库：anti-AD / StevenBlack
# 同上，QUIC 通道版本。走 UDP，所以日志里显示为 UDP Relay 而不是域名。
DOMAIN-SUFFIX, sdkquic.e.qq.com, REJECT

# Google DoubleClick / Ad Manager
# 抓包命中 3 次 | 权威广告库：anti-AD / StevenBlack
# googleads.g / pubads.g 都是它的子域。这是抓包中 某社交 App 会话里同步出现的广告投放域。
DOMAIN-SUFFIX, doubleclick.net, REJECT

# Google DoubleClick (中国镜像)
# 本机 App 类别：某社交 App | 抓包命中 17 次 | 权威广告库：anti-AD
# googleads.g.doubleclick-cn.net 13 次 + adx.g.doubleclick-cn.net 4 次。中国区镜像，出现在 X 的每一次会话里。
DOMAIN-SUFFIX, doubleclick-cn.net, REJECT

# Google AdSense / GMA SDK
# 本机 App 类别：某社交 App | 抓包命中 6 次 | 权威广告库：anti-AD / StevenBlack
# pagead2.googlesyndication.com。和 connectivitycheck.gstatic.com 同一时刻触发，是 GMA SDK 初始化的标志。
DOMAIN-SUFFIX, googlesyndication.com, REJECT

# Google AdSense (中国镜像)
# 本机 App 类别：某社交 App | 抓包命中 6 次 | 权威广告库：anti-AD
# pagead2 / tpc 子域。中国区走这个而不是 .com。
DOMAIN-SUFFIX, googlesyndication-cn.com, REJECT

# Google 广告素材 CDN
# 抓包命中 2 次 | 权威广告库：anti-AD
# lh3.googleadsserving.cn，Google 广告创意图站，和 googlevideo 的 gmasdk 素材同一批。
DOMAIN-SUFFIX, googleadsserving.cn, REJECT

# Google IMA 视频广告 SDK
# 本机 App 类别：某社交 App | 抓包命中 2 次 | 权威广告库：anti-AD
# Google Interactive Media Ads —— App 内视频贴片广告的播放器 SDK。
# 注意别跟 crashlyticsreports-pa.googleapis.com 搞混，后者在 never 档。
DOMAIN-SUFFIX, imasdk.googleapis.com, REJECT

# FancyDSP
# 抓包命中 6 次 | 权威广告库：anti-AD / AdGuard-CN
# mpcfg / ad-open2 / applus 三个子域。DSP = 需求方平台，买量投广告的。
DOMAIN-SUFFIX, fancydsp.com, REJECT

# FancyDSP
# 抓包命中 15 次 | 权威广告库：anti-AD / AdGuard-CN
# t2 / sdkg / static / g / lftxali 五个子域，是这套 SDK 里请求最多的。
DOMAIN-SUFFIX, fancyapi.com, REJECT

# 广告网盟 (adwangmai)
# 抓包命中 8 次 | 权威广告库：anti-AD
# sdk.adx / sdk-cfg.adx 两个子域。adx = ad exchange，交易所本身就是广告位买卖。
DOMAIN-SUFFIX, adwangmai.com, REJECT

# hzzfcm 广告 SDK
# 抓包命中 6 次 | 权威广告库：anti-AD
# 只有 sdk.hzzfcm.com 一个子域，纯 SDK 端点。
DOMAIN-SUFFIX, hzzfcm.com, REJECT

# zhangyuyidong 广告 SDK
# 抓包命中 8 次 | 权威广告库：anti-AD
# sdk / sdklog / iosid 三个子域。个人域名挂广告 SDK，典型的小广告联盟。
DOMAIN-SUFFIX, zhangyuyidong.cn, REJECT

# 倍孜 (Beizi) 广告 SDK
# 抓包命中 4 次 | 权威广告库：anti-AD / AdGuard-CN
# sdk / api-htp 两个子域。有公开的 SDK 文档站 sdkdoc.beizi.biz，确认是广告 SDK。
DOMAIN-SUFFIX, beizi.biz, REJECT

# 1RTB
# 本机 App 类别：某智能门锁 App | 抓包命中 7 次 | 权威广告库：anti-AD
# rtb = real-time bidding，实时竞价广告。某智能门锁 App 的 UA 直接挂着它。
DOMAIN-SUFFIX, 1rtb.net, REJECT

# TopOn 广告聚合
# 抓包命中 5 次 | 权威广告库：anti-AD
# mores.toponad.com。TopOn 是聚合多家广告 SDK 的中介层。
DOMAIN-SUFFIX, toponad.com, REJECT

# AnyThink (TopOn 海外品牌)
# 本机 App 类别：某智能门锁 App | 抓包命中 1 次 | 权威广告库：anti-AD
# mores.anythinktech.com，与 toponad 同一家。
DOMAIN-SUFFIX, anythinktech.com, REJECT

# 66mobi 广告 SDK
# 抓包命中 5 次 | 权威广告库：anti-AD
# sdk-track / tstatic / tencent-ssp / static 四个子域。
DOMAIN-SUFFIX, 66mobi.com, REJECT

# Smadex DSP
# 抓包命中 6 次 | 权威广告库：anti-AD / StevenBlack
# creatives / statics / static-content-1 三个子域。海外 DSP，creatives 就是广告创意素材。
DOMAIN-SUFFIX, smadex.com, REJECT

# Moloco DSP
# 抓包命中 4 次 | 权威广告库：anti-AD / StevenBlack
# cdn-f.adsmoloco.com。Moloco 是 App 内广告的 DSP，cdn-f 是素材分发。
DOMAIN-SUFFIX, adsmoloco.com, REJECT

# puata 广告 SDK
# 抓包命中 2 次 | 权威广告库：anti-AD / AdGuard-CN
# yumao.puata.info —— "yumao"(羽毛) 这类随机前缀是广告 SDK 躲检测的常见手法。
DOMAIN-SUFFIX, puata.info, REJECT

# AdScope 广告平台
# 抓包命中 1 次 | 权威广告库：anti-AD
# resource-m-r.ad-scope.com.cn，resource 子域说明是素材分发。
DOMAIN-SUFFIX, ad-scope.com.cn, REJECT

# statisticslinks 广告策略埋点
# 抓包命中 2 次 | 权威广告库：anti-AD
# adx-strategy-api-cn / tk 两个子域。域名带 statistics，但子域是 adx-strategy，属于广告决策链路。
DOMAIN-SUFFIX, statisticslinks.com, REJECT

# 阿里妈妈 Tanx（Ad Exchange）
# 本机 App 类别：某电商 App | 抓包命中 4 次 | 权威广告库：anti-AD
# 阿里妈妈的实时广告交易平台，抓包里 4 个子域全被访问且全部直连放行：bdlog（广告日志）、df（数据流）、et（投放）、kgb-ifs。
# 是同一次会话里某电商 App 调用的——同秒有 adashx / atoken 与阿里 IPv6 段在跑。anti-AD 收录了 29 个 tanx 域名，含 df 与 et 两个。
DOMAIN-SUFFIX, tanx.com, REJECT

# 友盟广告
# 抓包命中 1 次 | 权威广告库：anti-AD / StevenBlack
# 只拦 ads.umeng.com 这个专门做广告的子域。友盟主域 umeng.com 的统计功能另算，且不在本模块里。
DOMAIN-SUFFIX, ads.umeng.com, REJECT

# hubcloud adx
# 抓包命中 1 次 | 权威广告库：anti-AD / AdGuard-CN
# v = video，adx = 广告交易所。刻意写成完整子域而不是 hubcloud.com.cn：同域下还有 api.htp / sdk / res1 / sdktmp 等在跑
# ，DOMAIN-SUFFIX 打在根域上会连 App 核心 API 一起拦掉。
DOMAIN-SUFFIX, v.adx.hubcloud.com.cn, REJECT

# 某券商 App 自营广告
# 本机 App 类别：某券商 App | 抓包命中 1381 次 | 权威广告库：anti-AD
# 抓包里请求量第一的域名。按路径拦（只拦 /infoService/vN）会让 App 被 REJECT 后继续重试——这份抓包里重试了 1381 次。按整个域名拦，
# 在 TCP 层就断开。
DOMAIN-SUFFIX, emdcadvertise.eastmoney.com, REJECT

# 中国联通自营广告
# 抓包命中 3 次 | 权威广告库：anti-AD
# 中国联通自营广告接口。域名直译就是 smart ad。
DOMAIN-SUFFIX, smartad.10010.com, REJECT

# 某音乐 App 广告素材 CDN
# 本机 App 类别：某音乐 App | 抓包命中 3 次 | 权威广告库：anti-AD
# 某音乐 App 广告素材 CDN。etease 专用去广告模块也会拦它；这里列一份是为了本模块单独装也能完整生效（两处都拦不会冲突）。
DOMAIN-SUFFIX, iadmusicmat.music.126.net, REJECT

# 某音乐 App 广告素材 CDN
# 本机 App 类别：某音乐 App | 抓包命中 3 次 | 权威广告库：anti-AD
# 同上，某音乐 App 广告素材 CDN。
DOMAIN-SUFFIX, iadmat.nosdn.127.net, REJECT

# 淘宝广告统计 adashx
# 本机 App 类别：某电商 App | 抓包命中 13 次（DIRECT 6 / PROXY 7） | 权威广告库：多个社区「淘宝去广告」模块
# adashx = ad + ashx，淘宝/天猫广告曝光与点击统计端点。社区「淘宝去广告」模块均以 DOMAIN 精确拦截本域。
# 注意：同族的 amdc.m.taobao.com（投放调度）不能拦 —— anti-AD issue #778 记录，拦了会导致阿里系 App 异常。
DOMAIN-SUFFIX, adashx.m.taobao.com, REJECT

# 淘宝广告统计 h-adashx（无线端）
# 本机 App 类别：某电商 App | 抓包命中 10 次（DIRECT 7 / PROXY 3） | 权威广告库：多个社区「淘宝去广告」模块
# ut = Universal Tracking。与 adashx 同一套广告埋点体系，社区模块同样精确拦截。
DOMAIN-SUFFIX, h-adashx.ut.taobao.com, REJECT

# 腾讯优量汇（广点通）广告素材 CDN
# 本机 App 类别：未确定 | 抓包命中 1 次（PROXY） | 权威广告库：Tencent 自有域名（证书 CN=*.ugdtimg.com，O=Tencent Technology）
# ugdtimg = Union GDT Image。和 ad 档已拦的 gdtimg.com 是两个不同注册域，所以 gdtimg.com 的后缀规则覆盖不到它。
# 本次抓到的是 adsmind.ugdtimg.com（ad + mind），子域名字面就是广告。
DOMAIN-SUFFIX, ugdtimg.com, REJECT

# 小米广告 SDK 配置
# 本机 App 类别：系统 / 米家 | 抓包命中 1 次 | 权威广告库：小米官方《广告SDK集成指南》《米盟广告SDK隐私政策》
# 官方文档对 sdkconfig 的用途写明「用于请求广告数据」。只拦这个具体子域，不动 xiaomi.com 根域。
DOMAIN-SUFFIX, sdkconfig.ad.xiaomi.com, REJECT

# Google 广告服务（app-ads-services）
# 抓包命中 11 次（muf 7 / odf 4） | 权威广告库：AdGuard Mobile Ads / pcrisk
# 第一手验证：GET 返回 302 → https://www.google.com/，Server: sffe（Google 前端）；子域 muf/odf 返回 Google 404 页。
# AdGuard Mobile Ads 过滤表整域收录。
DOMAIN-SUFFIX, app-ads-services.com, REJECT

# Google 广告（googleadservices）
# 抓包命中 1 次（PROXY） | 权威广告库：Google 官方隐私条款
# Google 自述其广告 Cookie 会从 googleadservices.com 等域下发；该域专用于 Google Ads 点击追踪。
DOMAIN-SUFFIX, googleadservices.com, REJECT

# ==========================================================================
# B 档 · 证据稍弱（只有供应商身份，没有权威库背书）—— 默认注释掉
# ==========================================================================
# 域名形态和厂商身份都指向广告，但权威库没收录，所以证据少一票。想连它们一起拦，把下面每一行的行首 # 删掉即可。逐条注释里写了各自的证据强度。

# 8ziben DSP
# 本机 App 类别：某智能门锁 App | 抓包命中 34 次 | 权威广告库：无（仅靠供应商身份判定）
# api-events / api-cfg / api-dsp / static-dsp 四个子域，全是 SDK 端点。某智能门锁 App 的 UA 直接对应。
# 请求量比很多强证据域名还高，但没进任何权威库，所以放这一档。
# DOMAIN-SUFFIX, 8ziben.com, REJECT

# kuiniuca —— PCDN，不是广告（默认注释，且不建议拦）
# 抓包命中 14 次 | 权威广告库：无
# 更正：v1.0.3 曾把它标成「广告 SDK」，这个判断是错的。实地核对后确认 kuiniuca.com 是 PCDN
# （P2P CDN，用终端设备做视频分发），和 xinqiucc.com / qiezibenpao.com 同属一类。
# 依据：V2EX「可屏蔽的 PCDN 域名」帖把 kuiniuca 与 xinqiucc 并列；同域接口返回 surl 相关错误。
# PCDN 偷的是上行带宽，不是广告，所以不归本模块管。要治 PCDN 请另开模块。
# DOMAIN-SUFFIX, kuiniuca.com, REJECT

# Buluken 广告 SDK
# 抓包命中 5 次 | 权威广告库：无（仅靠供应商身份判定）
# bid / sl / sdkconf 三个子域。bid = 竞价，是广告 SDK 的强特征。
# DOMAIN-SUFFIX, buluken.com, REJECT

# CPC 广告计费
# 抓包命中 2 次 | 权威广告库：无（仅靠供应商身份判定）
# cpc-service-square.iggrowth.cn。CPC = cost per click，按点击计费，只有广告业务用这个词。
# DOMAIN-SUFFIX, iggrowth.cn, REJECT

# CPC 广告计费
# 抓包命中 2 次 | 权威广告库：无（仅靠供应商身份判定）
# 和 iggrowth.cn 同一套 CPC 计费后端。只写这一个子域：同域下还有 usr-api / service / logrcv / tracelog-debug 在跑，
# 打根域会连它们一起拦掉。
# DOMAIN-SUFFIX, cpc-service-square.yunxish.com, REJECT

# askdiandian 广告 SDK
# 本机 App 类别：某内容社区 App | 抓包命中 1 次 | 权威广告库：无（仅靠供应商身份判定）
# 某内容社区 App App 的 UA 唯一一次访问。只出现 1 次，证据最薄的一条。
# DOMAIN-SUFFIX, askdiandian.com, REJECT

# Moloco DSP
# 抓包命中 1 次 | 权威广告库：无（仅靠供应商身份判定）
# eventfnt-asia.dsp-api.moloco.com。Moloco 在 ad 档已有 cdn-f.adsmoloco.com，这条是投放 API；
# 分开列是因为 adsmoloco.com 和 moloco.com 是不同注册域。
# DOMAIN-SUFFIX, dsp-api.moloco.com, REJECT

# 萤石 adx
# 抓包命中 1 次 | 权威广告库：无（仅靠供应商身份判定）
# ys7.com 是萤石云。adx 子域是广告交易所，1 次。
# DOMAIN-SUFFIX, adx.ys7.com, REJECT

# ==========================================================================
# 层二 · 路径级（需要 HTTPS 解密 / MITM）
# ==========================================================================
# 纯广告域用上面的域名级规则就够。但下面这几个 App 的开屏广告挂在第一方域名下，
# 只能拦路径 —— 拦整个域名会把 App 主功能一起搞挂。
#
# 为什么今天才加这一段：域名级规则天然看不见“同一个域名下的某条广告接口”。
# 网易云的 link/position/show/resource 在日志里跑了 352 次，域名是 interface3.music.163.com，
# 域名级永远拦不到；高德的 startup/configuration/v3 同理。
#
# 语法：<正则> <动作>。REJECT-DICT 返回空 JSON（客户端能解析但拿不到广告），
# REJECT-200 返回空 200。两者都比直接 REJECT 温和，减少 App 报错重试。
# 正则里 / 不需要转义，但 . 需要；[a-z]*api 同时覆盖 eapi / xeapi / api 三种前缀。

[URL Rewrite]

# 网易云音乐 · 资源位广告（开屏 / 我的页顶栏）
# 抓包：eapi/link/position/show/resource 352 次（DIRECT 316 / PROXY 36），本模块最大漏网点。
# 社区「网易云音乐去广告」模块把同一路径标注为「我的 MyPageBar ad」。
# 注意：原模块已有规则只覆盖 position/show/strategy，没覆盖 resource —— 这里补齐两者。
# 风险：该接口可能同时返回非广告的资源位数据，REJECT-DICT 会让这些位置变空。若「我的」页出现异常，注释掉本行即可。
^https?://(ipv4|interface\d?)\.music\.163\.com\/[a-z]*api\/link\/position\/show\/(resource|strategy) REJECT-DICT

# 高德地图 · 开屏 DSP 配置
# 抓包：startup/configuration/v3 1 次 DIRECT；startup/init 已被别的模块拦。
# DSP = 需求方平台，startup 下的接口只负责启动时的广告初始化与配置下发。用 /startup/ 前缀一次覆盖两者。
^https?://m5\.amap\.com\/ws\/shield\/dsp\/app\/startup\/ REJECT-200

# 阿里 · 开屏弹层模板
# 抓包：poplayer.template.alibaba.com 2 次（DIRECT 1 / PROXY 1）。
# poplayer 是阿里系 App 的弹层/开屏广告模板系统；社区规则按 /\w+\.json 精确拦。
^https?://poplayer\.template\.alibaba\.com\/ REJECT-200

# 淘宝 / 闲鱼 · 开屏广告（可选，默认关闭）
# 社区 Shadowrocket 模块里公开的开屏规则。默认注释，因为给 acs.m.taobao.com 开 MITM
# 有概率与淘宝的证书校验冲突；真要用，把下面两行解除注释，并把 acs.m.taobao.com 加进 [MITM]。
# ^https?://acs\.m\.taobao\.com\/gw\/mtop\.(taobao\.wireless\.home\.(splash|newface)\.awesome\.get|alibaba\.advertisementservice\.getadv) REJECT-200
# ^https?://acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash REJECT-200

[MITM]
# %APPEND% 表示追加到其它模块已有的 hostname 列表，不会覆盖。
# 只列上面确实需要解密的域，不做全域 MITM。
hostname = %APPEND% interface3.music.163.com, ipv4.music.163.com, m5.amap.com, poplayer.template.alibaba.com

